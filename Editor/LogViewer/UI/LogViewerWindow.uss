.lvw-root {
    flex-grow: 1;
    min-height: 0;
}

.lvw-toolbar {
    flex-shrink: 0;
}

.lvw-tb-btn {
    -unity-text-align: middle-center;
}

.lvw-tb-spacer {
    width: 8px;
    flex-shrink: 0;
}

.lvw-tb-flex {
    flex-grow: 1;
}

.lvw-level-toggles {
    flex-direction: row;
    align-items: stretch;
}

.lvw-level-toggle {
    margin-left: 1px;
    margin-right: 1px;
    min-width: 26px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.lvw-search-field {
    width: 200px;
    margin-left: 2px;
    flex-shrink: 0;
}

.lvw-content {
    flex-grow: 1;
    min-height: 0;
}

.lvw-splitter {
    flex-grow: 1;
    min-height: 0;
}

.lvw-list-host {
    flex-grow: 1;
    min-height: 0;
}

.lvw-list {
    flex-grow: 1;
    min-height: 0;
}

.lvw-empty-hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: rgb(130, 130, 130);
}

.lvw-row {
    flex-direction: row;
    align-items: center;
    padding-left: 2px;
    padding-right: 4px;
}

.lvw-row-stripe {
    width: 3px;
    height: 14px;
    margin-right: 4px;
    border-radius: 1px;
    flex-shrink: 0;
}

.lvw-row-time {
    width: 64px;
    flex-shrink: 0;
    color: rgb(140, 140, 140);
    font-size: 11px;
}

.lvw-row-frame {
    width: 44px;
    flex-shrink: 0;
    color: rgb(120, 120, 120);
    font-size: 11px;
}

.lvw-row-tag {
    flex-shrink: 0;
    min-width: 70px;
    max-width: 220px;
    margin-right: 6px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
}

.lvw-row-msg {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
}

.lvw-detail {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0.15);
}

.lvw-detail-label {
    white-space: normal;
    padding: 6px;
    font-size: 12px;
}

.lvw-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 18px;
    padding-left: 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.lvw-footer-label {
    font-size: 11px;
    color: rgb(150, 150, 150);
}
